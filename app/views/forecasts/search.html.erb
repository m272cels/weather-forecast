<%= turbo_frame_tag :forecasts_search do %>
  <div class="grid grid-cols-2 mt-10">
    <div>
      <h1 class="font-bold text-2xl">Current weather for <%= @zip %></h1>
      <% if @address.present? %>
        <p>(<%= @address %>)</p>
      <% end %>
      <% if @from_cache %>
        <p>Fetched <%= time_ago_in_words(@current_weather["fetched_at"]) %> ago</p>
      <% else %>
        <p>Updated just now.</p>
      <% end %>
    </div>
    <div>
      <h1 class="font-bold text-4xl p-8"><%= @current_weather.dig("main", "temp") %> °F</h1>
    </div>
  </div>
<% end %>
